local saved_system
local function restore_ui()
 clearhooks();m:write_u32(descriptors,saved_system);m:write_u32(context,0)
end
local function native(slot,args,prep,check,text)
 add(slot,args,function()restore_ui();if prep then prep()end end,check,function(phase)
  local map={s={11,4},e={10,8},c={10,0x40},r={13,8},t={13,1},['\r']={9,0x40},['v']={5,2},['\27']={4,0x80}}
  for i=1,#text do
   local pos=assert(map[text:sub(i,i)]);local start=10+(i-1)*12
   if phase==start or phase==start+6 then
    local tag=(neo and ':ROW' or ':COL.')..pos[1]
    for _,field in pairs(machine.ioport.ports[tag].fields)do if field.mask==pos[2]then if phase==start then field:set_value(1)else field:clear_value()end end end
   end
  end
 end)
 cases[#cases][6]=140
end
