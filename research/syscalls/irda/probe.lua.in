local function ret(v,mask)return function()eq(cpu.state.D0.value&(mask or 0xffffffff),v)end end
local function byte(a,v)return function()eq(m:read_u8(a),v)end end
local taps={};local patches={}
local function hook(a,fn)
 -- Substitute only a lower transport routine in this disposable emulator.
 -- Direct writes are necessary: instruction fetch can bypass read-tap values.
 if neo then fn();return end
 patches[#patches+1]={a,m:read_direct_u16(a),m:read_direct_u16(a+2)}
 m:write_direct_u16(a,0x7000);m:write_direct_u16(a+2,0x4e75)
 eq(m:read_direct_u16(a),0x7000);fn()
end
local function clearhooks()
