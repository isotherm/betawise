local index,frame,failed,phase=0,0,false,-1
emu.register_frame_done(function()
 if failed then return end;frame=frame+1;if frame<first then return end
 local ok,err=pcall(function()
 if phase==-1 then
  if not saved_system then saved_system=m:read_u32(descriptors)end
  index=index+1;if index>#cases then print('PASS service probe '..#cases..' cases');machine:exit();return end
  phase=0
  local p=cases[index];if p[3]then p[3]()end
  local stop=code+2
  if p[1]>10000 then m:write_u16(code,0x4ef9);m:write_u32(code+2,p[1]-10000);stop=code+6 else m:write_u16(code,0xa000+4*p[1])end
  m:write_u16(stop,0x60fe);m:write_u32(stack,stop)
  for i,v in ipairs(p[2])do m:write_u32(stack+4*i,v)end
  cpu.state.D0.value=0xa5a5a5a5;cpu.state.A0.value=0x77777770;cpu.state.SR.value=p[6]and 0x2000 or 0x2700;cpu.state.SP.value=stack;cpu.state.PC.value=code
 else
  phase=phase+1;local p=cases[index]
  if p[5]then p[5](phase)end
  if phase==(p[6]or 4)then
   local stop=code+(p[1]>10000 and 6 or 2);assert(cpu.state.PC.value==stop or cpu.state.PC.value==stop+2,string.format('busy PC=%x',cpu.state.PC.value));eq(cpu.state.SP.value,stack+4);p[4]();print('PASS slot '..p[1]..' case '..index);phase=-1
  end
 end
 end)
 if not ok then failed=true;print('FAIL service slot '..(cases[index]and cases[index][1]or -1)..' case '..index..' '..tostring(err));machine:exit()end
end)
