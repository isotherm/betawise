 add(179,{cursor,4,data+0x800,0,plain,0,0,0,0,0},function()file('abcdef');state();fill(cursor,44);m:write_u32(cursor,editor);if neo then m:write_u32(cursor+0x10,m:read_u32(0x5c68))end;fill(data+0x800,16,0xa5)end,function()eq(cpu.state.D0.value,4);eq(m:read_u32(cursor+4),4);assert(bytes(data+0x800,4)=='abcd');eq(m:read_u8(data+0x804),0xa5)end)
end
