  file(text);state();fill(cursor,44);m:write_u32(cursor,editor);if neo then m:write_u32(cursor+16,m:read_u32(0x5c68))end;fill(data+0x800,24,0xa5)
 end,function()local want=skip==1 and 'ab' or 'ahb';eq(cpu.state.D0.value,#want);assert(bytes(data+0x800,#want)==want)end)
end end
