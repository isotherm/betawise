local function typed_setup(text)
 file(text);cpu.state.A5.value=@_GLOBAL_OFFSET_TABLE_@
 local blob={@TYPED_BYTES@};for i,v in ipairs(blob)do m:write_u8(@TYPED_CODE@+i-1,v)end
end
add(10000+@typed_probe@,{},function()typed_setup('abc')end,function()eq(m:read_u32(data),0x70617373)end)
add(10000+@typed_form_probe@,{},function()typed_setup('<FORM><INPUT TYPE="TEXT" NAME="a" VALUE="hello"></FORM>')end,function()eq(m:read_u32(data),0x70617373)end)
local frame,index,phase,failed=0,0,-1,false
emu.register_frame_done(function()
 if failed then return end;frame=frame+1;if frame<first then return end
 local ok,err=pcall(function()
 if phase==-1 then
  index=index+1;if index>#cases then print('PASS text probe '..#cases..' cases');machine:exit();return end;phase=0
  local p=cases[index];if p[3]then p[3]()end
  local stop=code+2;if p[1]>10000 then m:write_u16(code,0x4ef9);m:write_u32(code+2,p[1]-10000);stop=code+6 else m:write_u16(code,0xa000+4*p[1])end;m:write_u16(stop,0x60fe);m:write_u32(stack,stop);for i,v in ipairs(p[2])do m:write_u32(stack+4*i,v)end
  cpu.state.D0.value=0xa5a5a5a5;cpu.state.A0.value=0x77777770;cpu.state.SR.value=0x2700;cpu.state.SP.value=stack;cpu.state.PC.value=code
 else
  phase=phase+1;if phase==4 then local p=cases[index];local pc=cpu.state.PC.value;local stop=code+(p[1]>10000 and 6 or 2);assert(pc==stop or pc==stop+2,string.format('busy PC=%x',pc));eq(cpu.state.SP.value,stack+4);p[4]();print('PASS slot '..p[1]..' case '..index);phase=-1 end
 end
 end)
 if not ok then failed=true;print('FAIL text slot '..(cases[index]and cases[index][1]or -1)..' case '..index..' '..tostring(err));machine:exit()end
end)
