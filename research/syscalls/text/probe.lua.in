local statistics={
 {'abc def.\rSecond line!',{21,3,3,2,1,2}}, {'abc',{3,0,0,1,0,0}},
 {'abc ',{4,1,1,1,0,0}}, {'one two three. ',{15,3,3,1,0,2}},
 {'one\rtwo\r',{8,2,2,3,2,0}}, {'',{0,0,0,0,0,0}}
}
for _,test in ipairs(statistics)do
 local text,want=test[1],test[2]
 add(187,{1,0,0xffffffff,data+0x800,data+0x804,data+0x808,data+0x80c,data+0x810,data+0x814,data+0x818,data+0x820},function()file(text);fill(data+0x800,40,0xa5)end,function()
  for i,v in ipairs(want)do eq(m:read_u32(data+0x7fc+4*i),v)end
