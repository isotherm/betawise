  fill(cursor,44,0xa5);m:write_u32(editor+0x18,5);m:write_u16(editor+0x20,0x1111);m:write_u16(editor+0x22,0x2222);m:write_u32(editor+0x24,9);m:write_u16(editor+0x3c,0x3333);m:write_u16(editor+0x3e,0x4444)
 end,function()eq(cpu.state.D0.value,mode==3 and 0x2000002 or 0);eq(m:read_u32(cursor),editor);if mode<3 then eq(m:read_u32(cursor+4),({0,5,9})[mode+1])end end)
end
