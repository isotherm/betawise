 add(179,{cursor,0xffffffff,0,0,1,0,0,0,sensitive,data+0x880},function()
  file('abc ABC');state();fill(cursor,44);m:write_u32(cursor,editor);if neo then m:write_u32(cursor+16,m:read_u32(0x5c68))end;put(data+0x880,'ABC')
 end,function()eq(cpu.state.D0.value,1);eq(m:read_u32(cursor+4),sensitive==1 and 4 or 0)end)
end
for _,expand in ipairs({0,1})do
 add(179,{cursor,100,data+0x800,0,1,0,0,expand,0,0},function()
  file('a'..string.char(0xa8)..'<FORM></FORM>'..string.char(neo and 0x9d or 0xa9)..'b');state();fill(cursor,44);m:write_u32(cursor,editor);if neo then m:write_u32(cursor+16,m:read_u32(0x5c68))end;fill(data+0x800,128,0xa5)
