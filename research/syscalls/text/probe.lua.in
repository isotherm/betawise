add(181,{cursor,data+0x800,3,1},nil,ret(0x2000005))
add(182,{cursor,1},function()m:write_u32(cursor+4,3)end,function()eq(cpu.state.D0.value,0);eq(m:read_u32(editor+0x24),3)end)
