local machine=manager.machine;local cpu=machine.devices[':maincpu'];local m=cpu.spaces.program
local neo=@NEO@;local code,data,stack=neo and 0x70000 or 0x36000,neo and 0x74000 or 0x38000,neo and 0x7f000 or 0x3f000
local editor,cursor,transfer,form,entry,buffer=data+0x100,data+0x200,data+0x300,data+0x400,neo and 0x10d2 or 0x1042,neo and 0x1509c or 0x4558
local first=neo and 150 or 540
local function eq(a,b)assert(a==b,string.format('%x ~= %x',a,b))end
local function fill(a,n,v)for i=0,n-1 do m:write_u8(a+i,v or 0)end end
local function put(a,s)for i=1,#s do m:write_u8(a+i-1,s:byte(i))end;m:write_u8(a+#s,0)end
local function bytes(a,n)local t={};for i=0,n-1 do t[#t+1]=string.char(m:read_u8(a+i))end;return table.concat(t)end
local function file(text)
 local clip=entry+0x48;local clipbuffer=buffer+0x10000
 fill(entry,0x90);fill(buffer,0x20000);put(buffer,text)
 m:write_u32(entry,buffer);m:write_u32(entry+4,#text);m:write_u32(entry+8,#text);m:write_u32(entry+12,0x10000);m:write_u32(entry+0x20,6);m:write_u16(entry+0x44,1);put(entry+0x34,'Probe')
 m:write_u32(clip,clipbuffer);m:write_u32(clip+12,0x10000);m:write_u32(clip+0x20,4);m:write_u16(clip+0x44,0xcb);put(clip+0x34,'Clipboard')
 local delta=neo and 0x90 or 0
 m:write_u32(0x3446+delta,clip);m:write_u32(0x354e+delta,buffer+0x20000)
 m:write_u32(0x3442+delta,entry);m:write_u32(0x344a+delta,clip);m:write_u32(0x355c+delta,0);m:write_u16(0xe02+delta,0);m:write_u32(0xf42+delta,entry);m:write_u8(0xf46+delta,1)
 m:write_u8(neo and 0x3e82 or 0x3df2,0)
end
local function state()
 fill(editor,0x60);m:write_u16(editor,1);m:write_u16(editor+0x12,40);m:write_u16(editor+0x14,4);m:write_u16(editor+0x16,neo and 64 or 4)
 if neo then local desc=m:read_u32(0x5c68);m:write_u32(editor+0x4e,desc)end
end
local function ret(v)return function()eq(cpu.state.D0.value,v)end end
local cases={};local function add(slot,args,prep,check)cases[#cases+1]={slot,args,prep,check}end
add(114,{1,0},function()file('abc def.\rSecond line!')end,ret(1))
add(175,{editor,0xcb,3,100,1,1,10,2},function()file('abc');fill(editor,0x60,0xa5)end,function()
 eq(cpu.state.D0.value,0);eq(m:read_u16(editor),0xcb);eq(m:read_u32(editor+2),100);eq(m:read_u16(editor+0x4a),1)
 print('editor rectangle',m:read_u16(editor+14),m:read_u16(editor+16),m:read_u16(editor+18),m:read_u16(editor+20),m:read_u16(editor+22))
end)
