-- Original-ROM tests. RAM fixtures provide inputs; syscall bodies are never replaced.
local machine = manager.machine
local cpu = machine.devices[':maincpu']
local m = cpu.spaces.program
local neo, group = @NEO@, '@GROUP@'
local code, data, stack = neo and 0x70000 or 0x36000, neo and 0x74000 or 0x38000, neo and 0x7f000 or 0x3f000
local first = neo and 150 or 540
local cases = {}
local function add(slot, args, prep, check, tick, frames, special)
    cases[#cases + 1] = {slot=slot, args=args, prep=prep, check=check, tick=tick, frames=frames or 6, special=special}
end
local function eq(a, b) assert(a == b, string.format('%x ~= %x', a, b)) end
local function ret(want, mask) return function() eq(cpu.state.D0.value & (mask or 0xffffffff), want & (mask or 0xffffffff)) end end
local function fill(a, n, v) for i=0,n-1 do m:write_u8(a+i, v or 0) end end
local function put(a, s) for i=1,#s do m:write_u8(a+i-1,s:byte(i)) end; m:write_u8(a+#s,0) end
local function bytes(a, n) local t={}; for i=0,n-1 do t[#t+1]=string.char(m:read_u8(a+i)) end; return table.concat(t) end
local function lcd()
    local rows={}
    for _,tag in ipairs({':ks0066_0', ':ks0066_1'}) do
        local d = emu.item(assert(machine.devices[tag].items['0/m_ddram']))
        rows[#rows+1]=d:read_block(0,40); rows[#rows+1]=d:read_block(0x40,40)
    end
    return table.concat(rows)
end
local function key(event)
    -- Enter through the native QueueKey routine, not a patched keyboard handler.
    local a=code+0x100
    local old=cpu.state.SP.value
    local words={0x40e7,0x48e7,0xfffe,0x2f3c,(event>>16)&65535,event&65535,
                 0x4eb9,(code+0x140)>>16,(code+0x140)&65535,0x588f,
                 0x4cdf,0x7fff,0x46df,0x4e75}
    for i,v in ipairs(words) do m:write_u16(a+2*(i-1),v) end
    m:write_u16(code+0x140,0xa0a8)
    m:write_u32(old-4,cpu.state.PC.value)
    cpu.state.SP.value=old-4;cpu.state.PC.value=a
end
local function queueLater(event)
    return function(t) if t==2 then key(event) end end
end
local function escapeLater(t)
    if t==10 or t==16 then
        local tag=(neo and ':ROW' or ':COL.')..4
        for _,field in pairs(machine.ioport.ports[tag].fields) do
            if field.mask==0x80 then
                if t==10 then field:set_value(1) else field:clear_value() end
            end
        end
    end
end
local entry = neo and 0x10d2 or 0x1042
local buffer = neo and 0x1509c or 0x4558
local delta = neo and 0x90 or 0
local function file(text)
    fill(entry,0x90); fill(buffer,0x20000); put(buffer,text)
    m:write_u32(entry,buffer); m:write_u32(entry+4,#text); m:write_u32(entry+8,#text)
    m:write_u32(entry+12,0x10000); m:write_u32(entry+0x20,6); m:write_u16(entry+0x44,1); put(entry+0x34,'Probe')
    local clip=entry+0x48
    m:write_u32(clip,buffer+0x10000); m:write_u32(clip+12,0x10000)
    m:write_u32(clip+0x20,4); m:write_u16(clip+0x44,0xcb); put(clip+0x34,'Clipboard')
    m:write_u32(0x3446+delta,clip); m:write_u32(0x344a+delta,clip)
    m:write_u32(0x3442+delta,entry); m:write_u32(0x354e+delta,buffer+0x20000)
    m:write_u32(0x355c+delta,0); m:write_u16(0xe02+delta,0)
    m:write_u32(0xf42+delta,entry); m:write_u8(0xf46+delta,1)
    m:write_u8(neo and 0x3e82 or 0x3df2,0)
end
local function input(s)
    local a=neo and 0x118ab or 0x447b
    put(a,s); m:write_u8(a+80,0); m:write_u8(a+81,#s)
end
if group == 'display' then
    add(0,{},nil,function() if not neo then assert(lcd()==string.rep(' ',160)) end end)
    add(1,{2,3,0x0c})
    add(2,{data,data+1},nil,function() eq(m:read_u8(data),2); eq(m:read_u8(data+1),3) end)
    add(4,{65},nil,function() if not neo then eq(lcd():byte(43),65) end end)
    add(5,{data+0x100},function() put(data+0x100,'XYZ') end,function() if not neo then assert(lcd():find('AXYZ',1,true)) end end)
    add(6,{0x0f})
    add(7,{data},function() fill(data,2,0xa5) end,function() eq(m:read_u8(data),0x0f); eq(m:read_u8(data+1),0xa5) end)
    add(8,{2,3,6},nil,function() if not neo then assert(lcd():sub(43,46)=='    ') end end)
    add(9,{2,3},nil,function() if not neo then assert(lcd():sub(41,120)==string.rep(' ',80)) end end)
    add(3,{1,data+0x100},function() put(data+0x100,'Hi') end,function() if not neo then assert(lcd():sub(20,21)=='Hi') end end)
    add(10,{})
    add(0,{})
    add(11,{},nil,function() if not neo then assert(lcd():sub(20,21)=='Hi') end end)
    add(12,{data+0x100},function() put(data+0x100,'B\nC') end)
    add(13,{},nil,function() if not neo then eq(m:read_u8(0x423e),0xff) end end)
    add(1,{1,1,0x0c})
    add(15,{90},nil,function() eq(m:read_u8(neo and 0x520c or 0x423e),90) end)
    add(14,{1,data,data+2,data+2},function() m:write_u8(data,1);m:write_u8(data+1,1);m:write_u8(data+2,1);m:write_u8(data+3,1) end,function() if not neo then eq(lcd():byte(1),90) end end)
    add(32,{4,65536,131072},nil,function() if not neo then assert(lcd():find('50%%')) end end)
    add(18,{0,0,1,1,data+0x100},function() m:write_u8(data+0x100,1) end)
    if neo then
        local function pixel()
            local ram=emu.item(assert(machine.devices[':lcd0'].items['0/m_ddram']))
            return ram:read_block(0,1):byte(1)&1
        end
        add(0,{})
        add(18,{0,0,1,1,data+0x100},function() m:write_u8(data+0x100,1) end,function() eq(pixel(),1) end)
        add(19,{0,0,1,1,data+0x100,1},function() m:write_u8(data+0x100,0xa5) end,function() eq(m:read_u8(data+0x100)&1,1) end)
        for _,test in ipairs({{5,0},{6,1},{2,0},{3,1},{4,0},{7,1}}) do
            local op,want=test[1],test[2]
            add(19,{0,0,1,1,data+0x100,op},function() m:write_u8(data+0x100,1) end,function() eq(pixel(),want) end)
        end
    end
