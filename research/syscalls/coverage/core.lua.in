        abortTap=m:install_read_tap(target,target+1,'abort-control-transfer',function()
            if cpu.state.SP.value==(neo and 0x7fff0 or 0x3fff0)
                and cpu.state.A6.value==0
                and (m:read_u8(neo and 0x35e2 or 0x3552)&0x80)~=0 then
                abortSeen=true
            end
        end)
    end,function()
        assert(abortSeen,'abort did not enter firmware control with reset SP/A6 and abort flag')
        abortTap:remove()
    end,nil,12,true)
end
local index,frame,phase,failed=0,0,-1,false
emu.register_frame_done(function()
    frame=frame+1
    if not neo then
        if frame==60 then machine.natkeyboard:post('y') end
        if frame==200 or frame==450 then machine.natkeyboard:post('\r') end
    end
    if failed or frame<first then return end
    local ok,err=pcall(function()
        if phase==-1 then
            index=index+1
            if index>#cases then print('PASS core complete '..group..' '..#cases..' cases');machine:exit();return end
            local p=cases[index]
            if p.prep then p.prep() end
            m:write_u16(code,0xa000+4*p.slot);m:write_u16(code+2,0x60fe);m:write_u32(stack,code+2)
            for i,v in ipairs(type(p.args)=='function' and p.args() or p.args) do m:write_u32(stack+4*i,v) end
            cpu.state.SR.value=0x2000;cpu.state.SP.value=stack;cpu.state.PC.value=code;phase=0
        else
            phase=phase+1
            local p=cases[index]
            if p.tick then p.tick(phase) end
            if phase==p.frames then
                if not p.special then
                    local pc=cpu.state.PC.value
                    assert(pc==code+2 or pc==code+4,string.format('busy PC=%x',pc));eq(cpu.state.SP.value,stack+4)
                end
                if p.check then p.check() end
                print('PASS core slot '..p.slot..' case '..index);phase=-1
            end
        end
    end)
    if not ok then failed=true;print(string.format('FAIL core %s case %d slot %d PC=%x SP=%x: %s',group,index,cases[index].slot,cpu.state.PC.value,cpu.state.SP.value,tostring(err)));machine:exit() end
end)
